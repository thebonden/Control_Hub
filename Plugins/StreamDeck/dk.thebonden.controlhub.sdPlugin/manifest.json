{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Control Hub",
  "Version": "0.0.1.0",
  "Author": "thebonden",
  "Description": "Styr PowerPoint og OBS via Control Hub / Control PowerPoint and OBS through Control Hub.",
  "UUID": "dk.thebonden.controlhub",
  "SDKVersion": 2,
  "CodePath": "plugin.js",
  "Nodejs": {
    "Version": "24"
  },
  "Software": {
    "MinimumVersion": "7.4"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Icon": "assets/plugin",
  "Category": "Control Hub",
  "CategoryIcon": "assets/action",
  "PropertyInspectorPath": "inspector.html",
  "Actions": [
    {
      "UUID": "dk.thebonden.controlhub.next",
      "Name": "Næste slide / Next slide",
      "Icon": "assets/action",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "assets/key",
          "Title": "Næste slide",
          "FontSize": 11
        }
      ],
      "Tooltip": "Næste slide / Next slide"
    },
    {
